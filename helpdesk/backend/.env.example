# Copie para .env e preencha: cp .env.example .env

# Obrigatórias
ANTHROPIC_API_KEY=sk-ant-...
JWT_SECRET=troque-por-um-segredo-aleatorio   # gere com: openssl rand -base64 32

# Opcionais
ANTHROPIC_MODEL=claude-sonnet-4-5            # modelo dos agentes
ANTHROPIC_MODEL_CLASSIFICADOR=claude-haiku-5-5   # modelo do classificador do orquestrador
JWT_EXPIRES_IN=8h
PORT=3000
CORS_ORIGIN=http://localhost:4200
