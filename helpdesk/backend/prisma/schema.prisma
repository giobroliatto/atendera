// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

model Ticket {
  id           Int      @id @default(autoincrement())
  titulo       String
  descricao    String
  status       String   @default("aberto")
  prioridade   String   @default("media")
  categoria    String   @default("geral")
  sugestaoIA   String?
  raciocinioIA String?
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  mensagens    MensagemChat[]
  comentarios  ComentarioTicket[]
}

// Comentários adicionados por agentes ou usuários num ticket
model ComentarioTicket {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  conteudo  String
  autor     String   @default("Agente IA")
  criadoEm DateTime @default(now())

  ticket    Ticket   @relation(fields: [ticketId], references: [id])
}

model MensagemChat {
  id        Int      @id @default(autoincrement())
  ticketId  Int?
  role      String
  conteudo  String
  criadoEm DateTime @default(now())

  ticket    Ticket?  @relation(fields: [ticketId], references: [id])
}

// Base de conhecimento para RAG
// Cada entrada é um artigo de suporte com seu vetor de embedding armazenado como JSON
model BaseConhecimento {
  id        Int      @id @default(autoincrement())
  titulo    String
  conteudo  String
  embedding String   // vetor float[] serializado: "[0.12, 0.34, ...]"
  criadoEm DateTime @default(now())
}

// ================================================================
// OBSERVABILIDADE — log de cada chamada à API da Anthropic
//
// Registra tokens (input/output), custo estimado, latência e
// quantas tool calls foram feitas. Permite auditar quanto cada
// agente custa e quanto tempo leva por invocação.
// ================================================================
model LogChamadaIA {
  id           Int      @id @default(autoincrement())
  agente       String   // "automatico" | "automatico_cot" | "interativo" | "relatorio" | "orquestrador"
  inputTokens  Int
  outputTokens Int
  custoUsd     Float    // (inputTokens * $3/1M) + (outputTokens * $15/1M)
  latenciaMs   Int
  toolCalls    Int      @default(0)
  ticketId     Int?
  criadoEm     DateTime @default(now())
}

// ================================================================
// HUMAN-IN-THE-LOOP — ação de escrita proposta pelo agente
//
// As ferramentas de escrita do chat NÃO alteram o ticket: elas criam
// uma AcaoPendente. A alteração só acontece quando o usuário clica em
// "Confirmar" na interface (POST /acoes/:id/confirmar). Assim, nem o
// modelo nem um prompt injection conseguem executar uma escrita sozinhos.
// ================================================================
model AcaoPendente {
  id          Int       @id @default(autoincrement())
  tipo        String    // "alterar_status" | "alterar_prioridade" | "adicionar_comentario"
  ticketId    Int
  dados       String    // argumentos validados da ação, serializados em JSON
  descricao   String    // texto legível exibido no cartão de confirmação
  estado      String    @default("pendente") // pendente | confirmada | cancelada | falhou
  criadoEm    DateTime  @default(now())
  resolvidoEm DateTime?
}
