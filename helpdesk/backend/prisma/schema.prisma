// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

model Ticket {
  id           Int      @id @default(autoincrement())
  titulo       String
  descricao    String
  status       String   @default("aberto")
  prioridade   String   @default("media")
  categoria    String   @default("geral")
  sugestaoIA   String?
  raciocinioIA String?
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  mensagens    MensagemChat[]
  comentarios  ComentarioTicket[]
}

// Comentários adicionados por agentes ou usuários num ticket
model ComentarioTicket {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  conteudo  String
  autor     String   @default("Agente IA")
  criadoEm DateTime @default(now())

  ticket    Ticket   @relation(fields: [ticketId], references: [id])
}

model MensagemChat {
  id        Int      @id @default(autoincrement())
  ticketId  Int?
  usuarioId Int?     // dono da conversa — cada usuário vê só o próprio histórico
  role      String
  conteudo  String
  criadoEm DateTime @default(now())

  ticket    Ticket?  @relation(fields: [ticketId], references: [id])
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])
}

// ================================================================
// AUTENTICAÇÃO — usuários do helpdesk
//
// A senha nunca é salva: guardamos só o hash scrypt com salt aleatório
// ("salt:hash" em hex). Login devolve um JWT assinado com JWT_SECRET.
// Usuários são criados pelo script: npm run usuario:criar
// ================================================================
model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senhaHash String
  criadoEm  DateTime @default(now())

  mensagens MensagemChat[]
  acoes     AcaoPendente[]
}

// Base de conhecimento para RAG
// Cada entrada é um artigo de suporte com seu vetor de embedding armazenado como JSON
model BaseConhecimento {
  id        Int      @id @default(autoincrement())
  titulo    String
  conteudo  String
  embedding String   // vetor float[] serializado: "[0.12, 0.34, ...]"
  criadoEm DateTime @default(now())
}

// ================================================================
// OBSERVABILIDADE — log de cada chamada à API da Anthropic
//
// Registra tokens (input/output), custo estimado, latência e
// quantas tool calls foram feitas. Permite auditar quanto cada
// agente custa e quanto tempo leva por invocação.
// ================================================================
model LogChamadaIA {
  id           Int      @id @default(autoincrement())
  agente       String   // "automatico" | "automatico_cot" | "interativo" | "relatorio" | "orquestrador"
  modelo       String?  // modelo que atendeu a chamada (null nos logs anteriores a este campo)
  inputTokens  Int      // fora do cache
  outputTokens Int
  cacheEscritaTokens Int @default(0) // gravados no prompt cache nesta chamada
  cacheLeituraTokens Int @default(0) // lidos do prompt cache (custam ~10% do input)
  custoUsd     Float    // calculado com o preço do modelo (tabela em observabilidade/logger.ts)
  latenciaMs   Int
  toolCalls    Int      @default(0)
  ticketId     Int?
  criadoEm     DateTime @default(now())
}

// ================================================================
// HUMAN-IN-THE-LOOP — ação de escrita proposta pelo agente
//
// As ferramentas de escrita do chat NÃO alteram o ticket: elas criam
// uma AcaoPendente. A alteração só acontece quando o usuário clica em
// "Confirmar" na interface (POST /acoes/:id/confirmar). Assim, nem o
// modelo nem um prompt injection conseguem executar uma escrita sozinhos.
// ================================================================
model AcaoPendente {
  id          Int       @id @default(autoincrement())
  tipo        String    // "alterar_status" | "alterar_prioridade" | "adicionar_comentario"
  ticketId    Int
  usuarioId   Int?      // quem pediu a ação no chat — só essa pessoa pode confirmar
  dados       String    // argumentos validados da ação, serializados em JSON
  descricao   String    // texto legível exibido no cartão de confirmação
  estado      String    @default("pendente") // pendente | confirmada | cancelada | falhou
  criadoEm    DateTime  @default(now())
  resolvidoEm DateTime?

  usuario     Usuario?  @relation(fields: [usuarioId], references: [id])
}
